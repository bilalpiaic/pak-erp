# PostgreSQL connection (server-side only — never expose to the browser)
# Local example:
# DATABASE_URL="postgresql://ubuntu@localhost:5432/garmentloop?schema=public"
# Neon example (use the pooled connection string from the Neon dashboard):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/garmentloop?schema=public"

# App
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_APP_NAME="GarmentLoop ERP"
NEXT_PUBLIC_CURRENCY="PKR"
