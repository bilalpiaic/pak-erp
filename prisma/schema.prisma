// GarmentLoop ERP V1 — Prisma schema
// Accounting truth lives in PostgreSQL; balances are derived from posted lines.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VoucherType {
  BPV
  BRV
  CPV
  CRV
  JV
  SI
  PI
  STJ
}

enum VoucherStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum NormalBalance {
  Debit
  Credit
}

enum AuditAction {
  CREATE
  UPDATE
  POST
  UNPOST
  CANCEL
  DELETE
  ACTIVATE
  DEACTIVATE
}

enum PartyType {
  Debtor
  Creditor
  Both
}

enum UserRole {
  ADMIN
  USER
}

enum ItemCategory {
  /// Finished output from production (BOMs) — sold on sales invoices.
  Saleable
  /// Purchased inputs used in production — bought on purchase invoices.
  Consumable
}

enum StockMoveType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
  PURCHASE_RETURN
  SALE_RETURN
}

enum StockMoveDirection {
  IN
  OUT
}

enum StockSourceDocument {
  SalesInvoice
  PurchaseInvoice
  StockAdjustment
}

enum StockAdjustmentReason {
  OPENING
  GAIN
  LOSS
  COUNT
}

model Company {
  id               BigInt   @id @default(autoincrement())
  name             String   @db.VarChar(200)
  address          String?  @db.Text
  ntn              String?  @db.VarChar(50)
  strn             String?  @db.VarChar(50)
  phone            String?  @db.VarChar(50)
  email            String?  @db.VarChar(150)
  currency         String   @default("PKR") @db.VarChar(10)
  fiscalYearStart  Int      @default(7) @map("fiscal_year_start") // 1–12, default July
  /// Marketing / demo tenant — isolated from live company data by company_id.
  isDemo           Boolean  @default(false) @map("is_demo")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts           Account[]
  vouchers           Voucher[]
  parties            Party[]
  fiscalYears        FiscalYear[]
  auditLogs          AuditLog[]
  salesInvoices      SalesInvoice[]
  items              Item[]
  stockMovements     StockMovement[]
  purchaseInvoices   PurchaseInvoice[]
  stockAdjustments   StockAdjustment[]

  @@index([isDemo])
  @@map("companies")
}

model Party {
  id               BigInt    @id @default(autoincrement())
  companyId        BigInt    @map("company_id")
  name             String    @db.VarChar(200)
  ntn              String?   @db.VarChar(50)
  partyType        PartyType @map("party_type")
  phone            String?   @db.VarChar(50)
  email            String?   @db.VarChar(150)
  address          String?   @db.Text
  isActive         Boolean   @default(true) @map("is_active")
  /// Optional demo/outstanding days used when AR/AP subledger is thin
  outstandingDays  Int?      @map("outstanding_days")
  outstandingAmount Decimal? @default(0.00) @map("outstanding_amount") @db.Decimal(18, 2)
  whtStatus        String?   @map("wht_status") @db.VarChar(20)
  /// Named Trade Debtors GL head for this party (sub-ledger). Null for creditors.
  accountId        BigInt?   @unique @map("account_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company            Company            @relation(fields: [companyId], references: [id])
  account            Account?           @relation(fields: [accountId], references: [id])
  vouchers           Voucher[]
  salesInvoices      SalesInvoice[]
  purchaseInvoices   PurchaseInvoice[]
  stockMovements     StockMovement[]

  @@unique([companyId, name])
  @@index([companyId, partyType])
  @@map("parties")
}

model FiscalYear {
  id        BigInt   @id @default(autoincrement())
  companyId BigInt   @map("company_id")
  name      String   @db.VarChar(50)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isOpen    Boolean  @default(true) @map("is_open")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("fiscal_years")
}

model Account {
  id            BigInt        @id @default(autoincrement())
  companyId     BigInt        @map("company_id")
  code          String        @db.VarChar(30)
  name          String        @db.VarChar(200)
  accountType   String        @map("account_type") @db.VarChar(30)
  accountGroup  String?       @map("account_group") @db.VarChar(100)
  /// Balance Sheet sub-head link (None for pure P&L accounts)
  bsSection     String        @default("None") @map("bs_section") @db.VarChar(40)
  /// Profit & Loss sub-head link (None for pure BS accounts)
  plSection     String        @default("None") @map("pl_section") @db.VarChar(40)
  /// Cash Flow statement link (activity + role)
  cfLink        String        @default("None") @map("cf_link") @db.VarChar(40)
  normalBalance NormalBalance @map("normal_balance")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id])
  voucherLines VoucherLine[]
  party        Party?

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, bsSection])
  @@index([companyId, plSection])
  @@index([companyId, cfLink])
  @@map("accounts")
}

model Voucher {
  id          BigInt        @id @default(autoincrement())
  companyId   BigInt        @map("company_id")
  voucherNo   String        @map("voucher_no") @db.VarChar(50)
  voucherType VoucherType   @map("voucher_type")
  voucherDate DateTime      @map("voucher_date") @db.Date
  referenceNo   String?       @map("reference_no") @db.VarChar(100)
  partyId       BigInt?       @map("party_id")
  partyName     String?       @map("party_name") @db.VarChar(200)
  partyNtn      String?       @map("party_ntn") @db.VarChar(50)
  whtApplicable Boolean       @default(false) @map("wht_applicable")
  narration     String?       @db.Text
  status        VoucherStatus @default(DRAFT)
  createdBy   String?       @map("created_by") @db.VarChar(100)
  postedBy    String?       @map("posted_by") @db.VarChar(100)
  cancelledBy String?       @map("cancelled_by") @db.VarChar(100)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt    DateTime?     @map("posted_at") @db.Timestamptz(6)
  cancelledAt DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company          Company            @relation(fields: [companyId], references: [id])
  party            Party?             @relation(fields: [partyId], references: [id])
  lines            VoucherLine[]
  attachments      VoucherAttachment[]
  salesInvoice     SalesInvoice?
  purchaseInvoice  PurchaseInvoice?
  stockAdjustment  StockAdjustment?
  stockMovements   StockMovement[]

  @@unique([companyId, voucherNo])
  @@index([companyId, voucherDate])
  @@index([companyId, status])
  @@index([partyId])
  @@map("vouchers")
}

/// Commercial sales invoice — posts Dr Trade Debtors / Cr Sales via linked SI voucher.
model SalesInvoice {
  id          BigInt        @id @default(autoincrement())
  companyId   BigInt        @map("company_id")
  voucherId   BigInt?       @unique @map("voucher_id")
  invoiceNo   String        @map("invoice_no") @db.VarChar(50)
  invoiceDate DateTime      @map("invoice_date") @db.Date
  partyId     BigInt        @map("party_id")
  partyName   String        @map("party_name") @db.VarChar(200)
  partyNtn    String?       @map("party_ntn") @db.VarChar(50)
  poNumber    String?       @map("po_number") @db.VarChar(100)
  narration   String?       @db.Text
  status      VoucherStatus @default(DRAFT)
  totalAmount Decimal       @default(0.00) @map("total_amount") @db.Decimal(18, 2)
  createdBy   String?       @map("created_by") @db.VarChar(100)
  postedBy    String?       @map("posted_by") @db.VarChar(100)
  cancelledBy String?       @map("cancelled_by") @db.VarChar(100)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt    DateTime?     @map("posted_at") @db.Timestamptz(6)
  cancelledAt DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company            @relation(fields: [companyId], references: [id])
  party   Party              @relation(fields: [partyId], references: [id])
  voucher Voucher?           @relation(fields: [voucherId], references: [id])
  lines   SalesInvoiceLine[]

  @@unique([companyId, invoiceNo])
  @@index([companyId, invoiceDate])
  @@index([companyId, status])
  @@index([partyId])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id             BigInt  @id @default(autoincrement())
  salesInvoiceId BigInt  @map("sales_invoice_id")
  lineNo         Int     @map("line_no")
  /// Optional stock item. Null = non-stock / free-text line (revenue only).
  itemId         BigInt? @map("item_id")
  item           String  @db.VarChar(200)
  detail         String? @db.Text
  quantity       Decimal @db.Decimal(18, 4)
  rate           Decimal @db.Decimal(18, 4)
  amount         Decimal @db.Decimal(18, 2)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  stockItem    Item?        @relation(fields: [itemId], references: [id])

  @@index([salesInvoiceId])
  @@index([itemId])
  @@map("sales_invoice_lines")
}

model VoucherAttachment {
  id           BigInt   @id @default(autoincrement())
  voucherId    BigInt   @map("voucher_id")
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(120)
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @map("storage_key") @db.VarChar(500)
  storageUrl   String   @map("storage_url") @db.Text
  uploadedBy   String?  @map("uploaded_by") @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@map("voucher_attachments")
}

model VoucherLine {
  id            BigInt  @id @default(autoincrement())
  voucherId     BigInt  @map("voucher_id")
  accountId     BigInt  @map("account_id")
  lineNarration String? @map("line_narration") @db.Text
  debit         Decimal @default(0.00) @db.Decimal(18, 2)
  credit        Decimal @default(0.00) @db.Decimal(18, 2)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@index([voucherId])
  @@index([accountId])
  @@map("voucher_lines")
}

model AuditLog {
  id         BigInt      @id @default(autoincrement())
  companyId  BigInt      @map("company_id")
  actor      String?     @db.VarChar(100)
  action     AuditAction
  entity     String      @db.VarChar(50)
  recordId   String      @map("record_id") @db.VarChar(50)
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, entity, recordId])
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

/// Application login credentials (username + password hash).
model User {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique @db.VarChar(80)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String   @map("display_name") @db.VarChar(150)
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  /// When true, session resolves only the demo company tenant (marketing).
  isDemo       Boolean  @default(false) @map("is_demo")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@index([isDemo])
  @@map("users")
}

/// Stock item master. On-hand qty/value is derived from posted stock_movements.
model Item {
  id              BigInt       @id @default(autoincrement())
  companyId       BigInt       @map("company_id")
  sku             String       @db.VarChar(40)
  name            String       @db.VarChar(200)
  category        ItemCategory
  unit            String       @default("Pcs") @db.VarChar(20)
  trackStock      Boolean      @default(true) @map("track_stock")
  isActive        Boolean      @default(true) @map("is_active")
  defaultSaleRate Decimal?     @map("default_sale_rate") @db.Decimal(18, 4)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company              Company               @relation(fields: [companyId], references: [id])
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  stockMovements       StockMovement[]
  adjustmentLines      StockAdjustmentLine[]

  @@unique([companyId, sku])
  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([companyId, category])
  @@map("items")
}

/// Quantity + value ledger. Rows exist only while the source voucher is POSTED
/// (created on post, deleted on unpost). Cancelled vouchers keep rows but
/// queries filter voucher.status = POSTED, so they drop out of on-hand.
model StockMovement {
  id                 BigInt               @id @default(autoincrement())
  companyId          BigInt               @map("company_id")
  itemId             BigInt               @map("item_id")
  moveDate           DateTime             @map("move_date") @db.Date
  direction          StockMoveDirection
  moveType           StockMoveType        @map("move_type")
  quantity           Decimal              @db.Decimal(18, 4)
  unitCostCents      Int                  @map("unit_cost_cents")
  valueCents         Int                  @map("value_cents")
  voucherId          BigInt               @map("voucher_id")
  sourceDocument     StockSourceDocument  @map("source_document")
  sourceDocumentId   BigInt               @map("source_document_id")
  sourceLineNo       Int                  @map("source_line_no")
  partyId            BigInt?              @map("party_id")
  narration          String?              @db.Text
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  item    Item    @relation(fields: [itemId], references: [id])
  voucher Voucher @relation(fields: [voucherId], references: [id])
  party   Party?  @relation(fields: [partyId], references: [id])

  @@index([companyId, itemId, moveDate])
  @@index([voucherId])
  @@index([sourceDocument, sourceDocumentId])
  @@index([partyId])
  @@map("stock_movements")
}

/// Commercial purchase invoice — posts Dr Stock in Trade / Cr Trade Creditors via linked PI voucher.
model PurchaseInvoice {
  id          BigInt        @id @default(autoincrement())
  companyId   BigInt        @map("company_id")
  voucherId   BigInt?       @unique @map("voucher_id")
  invoiceNo   String        @map("invoice_no") @db.VarChar(50)
  invoiceDate DateTime      @map("invoice_date") @db.Date
  partyId     BigInt        @map("party_id")
  partyName   String        @map("party_name") @db.VarChar(200)
  partyNtn    String?       @map("party_ntn") @db.VarChar(50)
  billNo      String?       @map("bill_no") @db.VarChar(100)
  narration   String?       @db.Text
  status      VoucherStatus @default(DRAFT)
  totalAmount Decimal       @default(0.00) @map("total_amount") @db.Decimal(18, 2)
  createdBy   String?       @map("created_by") @db.VarChar(100)
  postedBy    String?       @map("posted_by") @db.VarChar(100)
  cancelledBy String?       @map("cancelled_by") @db.VarChar(100)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt    DateTime?     @map("posted_at") @db.Timestamptz(6)
  cancelledAt DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company                @relation(fields: [companyId], references: [id])
  party   Party                  @relation(fields: [partyId], references: [id])
  voucher Voucher?               @relation(fields: [voucherId], references: [id])
  lines   PurchaseInvoiceLine[]

  @@unique([companyId, invoiceNo])
  @@index([companyId, invoiceDate])
  @@index([companyId, status])
  @@index([partyId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                BigInt  @id @default(autoincrement())
  purchaseInvoiceId BigInt  @map("purchase_invoice_id")
  lineNo            Int     @map("line_no")
  itemId            BigInt  @map("item_id")
  itemName          String  @map("item_name") @db.VarChar(200)
  detail            String? @db.Text
  quantity          Decimal @db.Decimal(18, 4)
  rate              Decimal @db.Decimal(18, 4)
  amount            Decimal @db.Decimal(18, 2)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  stockItem       Item            @relation(fields: [itemId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([itemId])
  @@map("purchase_invoice_lines")
}

/// Opening / gain / loss / count — posts Dr/Cr 1020 against capital or P&L via linked STJ voucher.
model StockAdjustment {
  id             BigInt                 @id @default(autoincrement())
  companyId      BigInt                 @map("company_id")
  voucherId      BigInt?                @unique @map("voucher_id")
  adjustmentNo   String                 @map("adjustment_no") @db.VarChar(50)
  adjustmentDate DateTime               @map("adjustment_date") @db.Date
  reason         StockAdjustmentReason
  narration      String?                @db.Text
  status         VoucherStatus          @default(DRAFT)
  createdBy      String?                @map("created_by") @db.VarChar(100)
  postedBy       String?                @map("posted_by") @db.VarChar(100)
  cancelledBy    String?                @map("cancelled_by") @db.VarChar(100)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  postedAt       DateTime?              @map("posted_at") @db.Timestamptz(6)
  cancelledAt    DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company                @relation(fields: [companyId], references: [id])
  voucher Voucher?               @relation(fields: [voucherId], references: [id])
  lines   StockAdjustmentLine[]

  @@unique([companyId, adjustmentNo])
  @@index([companyId, adjustmentDate])
  @@index([companyId, status])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id                 BigInt              @id @default(autoincrement())
  stockAdjustmentId  BigInt              @map("stock_adjustment_id")
  lineNo             Int                 @map("line_no")
  itemId             BigInt              @map("item_id")
  itemName           String              @map("item_name") @db.VarChar(200)
  direction          StockMoveDirection
  quantity           Decimal             @db.Decimal(18, 4)
  /// Required for IN (opening/gain). OUT uses WAC and ignores this except as display.
  unitCost           Decimal             @map("unit_cost") @db.Decimal(18, 4)
  amount             Decimal             @db.Decimal(18, 2)

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  stockItem       Item            @relation(fields: [itemId], references: [id])

  @@index([stockAdjustmentId])
  @@index([itemId])
  @@map("stock_adjustment_lines")
}
