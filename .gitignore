# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# local file uploads (when BLOB_READ_WRITE_TOKEN is unset)
.data/

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma generated client
/src/generated/prisma

# Local agent skill caches (if regenerated by Prisma CLI)
.agents/
.claude/
.windsurf/
skills-lock.json
