{
  "name": "GarmentLoop ERP",
  "user": "node",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "next-dev",
      "command": "npm run dev",
      "description": "Next.js development server (http://localhost:3000)"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    }
  ]
}
